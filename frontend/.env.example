# --- Static-data mode (the free public deployment) ---
# Base URL of the JSON files published by the "Publish F1 data" workflow.
# NEXT_PUBLIC_DATA_URL=https://huggingface.co/datasets/<your-hf-username>/pitwall-data/resolve/main/v1

# --- API mode (local development, or a paid backend host) ---
# Where the Next.js server forwards /api/f1/* requests. Default: http://127.0.0.1:8000
PITWALL_API_ORIGIN=http://127.0.0.1:8000
# Optional: let the browser call the API directly instead of through the proxy.
# NEXT_PUBLIC_API_URL=
