# Where the Next.js server forwards /api/f1/* requests (server-side only).
# Local default: http://127.0.0.1:8000 — on Vercel set it to your Hugging Face Space URL,
# e.g. https://your-hf-username-pitwall-api.hf.space
PITWALL_API_ORIGIN=http://127.0.0.1:8000

# Optional: make the browser call the API directly instead of through the proxy.
# NEXT_PUBLIC_API_URL=
