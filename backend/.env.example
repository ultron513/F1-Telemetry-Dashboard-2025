# Where FastF1 stores downloaded timing data (mount a persistent disk here in production)
F1_CACHE_DIR=../cache
# Set to 1 to never hit the network (only cached sessions work)
F1_OFFLINE=0
# How many fully-loaded sessions to keep in RAM (each is ~150-400 MB)
F1_SESSION_CACHE_SIZE=3
# Comma separated list of seasons exposed by the API
F1_SEASONS=2023,2024,2025,2026
F1_DEFAULT_SEASON=2025
# Exact frontend origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# Regex for additional origins (Vercel previews by default)
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- AI layer (optional) ------------------------------------------------------
# Without these, race reports use templates and "Ask the pit wall" uses the
# built-in rule-based analyst. Both are grounded in the same data either way.
# PITWALL_LLM_PROVIDER=anthropic          # or: openai (any OpenAI-compatible API)
# PITWALL_LLM_API_KEY=                    # falls back to ANTHROPIC_API_KEY / OPENAI_API_KEY
# PITWALL_LLM_MODEL=claude-sonnet-5-5     # e.g. gpt-4.1-mini, llama3.1 (Ollama)
# PITWALL_LLM_BASE_URL=                   # e.g. http://localhost:11434/v1 for Ollama
